{
  "name": "boxing-club-mvp",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Punch Club 风格的自动战斗 MVP —— React + Phaser 4",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "sim": "node --experimental-strip-types scripts/sim.ts",
    "sync:skills": "node scripts/sync-phaser-skills.mjs",
    "postinstall": "node scripts/sync-phaser-skills.mjs"
  },
  "dependencies": {
    "phaser": "^4.2.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
